# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORRELATION_ID_HEADER=x-correlation-id

# MongoDB Configuration
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/resumes
MONGODB_TIMEOUT=5000
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2

# Mistral Embeddings API
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_EMBEDDING_MODEL=mistral-embed
MISTRAL_TIMEOUT=5000
MISTRAL_MAX_RETRIES=2

# LLM Services (OpenAI)
LLM_API_KEY=your_openai_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_RERANKER_MODEL=gpt-4-turbo-preview
LLM_SUMMARIZER_MODEL=gpt-4-turbo-preview
LLM_TIMEOUT=15000
LLM_MAX_RETRIES=2

# Feature Flags
ENABLE_RERANKING=true
ENABLE_SUMMARIZATION=true
ENABLE_VECTOR_SEARCH=true

# Cache Configuration (Optional)
REDIS_URL=redis://localhost:6379
ENABLE_CACHE=false
CACHE_TTL=3600

# Security
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Observability
SENTRY_DSN=https://your_sentry_url
DATADOG_API_KEY=your_datadog_key
DEBUG_MODE=false
